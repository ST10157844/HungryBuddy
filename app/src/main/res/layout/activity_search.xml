<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hb_background"
    android:padding="16dp">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnSearchBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        android:textColor="@color/hb_on_accent"
        android:backgroundTint="@color/hb_orange" />

    <!-- Screen Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_recipes"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/hb_orange"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/etSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_recipe_name"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:layout_marginBottom="12dp" />

    <!-- Search Button -->
    <Button
        android:id="@+id/btnRunSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search"
        android:textColor="@color/hb_on_accent"
        android:backgroundTint="@color/hb_orange" />

    <!-- Results Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_results"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/hb_text_primary"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Search Results RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchRecipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Empty State or Error Message -->
        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/search_empty_prompt"
            android:textSize="16sp"
            android:textColor="@color/hb_text_muted"
            android:padding="16dp" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>



    <!-- Bottom Navigation -->
<include
layout="@layout/view_bottom_navigation"
android:layout_width="match_parent"
android:layout_height="wrap_content" />




    </LinearLayout>
