<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F2"
    android:padding="16dp">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnSearchBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E66B31" />

    <!-- Screen Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Recipes"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#E66B31"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/etSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter a recipe name"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:layout_marginBottom="12dp" />

    <!-- Search Button -->
    <Button
        android:id="@+id/btnRunSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E66B31" />

    <!-- Results Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Results"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Search Results RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchRecipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Empty State or Error Message -->
        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Enter a meal name to get started."
            android:textSize="16sp"
            android:textColor="#777777"
            android:padding="16dp" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>



    <!-- Bottom Navigation -->
<include
layout="@layout/view_bottom_navigation"
android:layout_width="match_parent"
android:layout_height="wrap_content" />




    </LinearLayout>
