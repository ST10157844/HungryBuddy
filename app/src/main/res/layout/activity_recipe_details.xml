<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hb_background"
    android:padding="16dp">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textColor="@color/hb_on_accent"
        android:backgroundTint="@color/hb_orange"
        android:layout_marginBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Scrollable Recipe Information -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/recipeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Recipe Image -->
                <ImageView
                    android:id="@+id/ivRecipeDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Recipe image"
                    android:layout_marginBottom="16dp" />

                <!-- Recipe Name -->
                <TextView
                    android:id="@+id/tvRecipeDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recipe Name"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/hb_orange"
                    android:layout_marginBottom="12dp" />

                <!-- Category -->
                <TextView
                    android:id="@+id/tvRecipeDetailCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="16sp"
                    android:textColor="@color/hb_text_secondary"
                    android:layout_marginBottom="8dp" />

                <!-- Cuisine -->
                <TextView
                    android:id="@+id/tvRecipeDetailArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cuisine"
                    android:textSize="16sp"
                    android:textColor="@color/hb_text_secondary"
                    android:layout_marginBottom="20dp" />

                <!-- Ingredients Heading -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingredients"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/hb_text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Dynamic Ingredients List -->
                <LinearLayout
                    android:id="@+id/ingredientsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp" />

                <!-- Instructions Heading -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cooking Instructions"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/hb_text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Cooking Instructions -->
                <TextView
                    android:id="@+id/tvRecipeInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cooking instructions will appear here."
                    android:textSize="16sp"
                    android:textColor="@color/hb_text_secondary"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginBottom="20dp" />

                <!-- Optional YouTube Video -->
                <Button
                    android:id="@+id/btnWatchVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Watch Cooking Video"
                    android:textColor="@color/hb_on_accent"
                    android:backgroundTint="@color/hb_orange"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

        </ScrollView>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressRecipeDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Error Message -->
        <TextView
            android:id="@+id/tvRecipeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Unable to load this recipe."
            android:textSize="16sp"
            android:textColor="@color/hb_error"
            android:padding="16dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
