<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access for Firebase and TheMealDB -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <application
	android:name=".HungryBuddyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HungryBuddy">

        <!-- Original Compose Activity: preserved -->

        <!-- New XML Login Activity: temporary launcher -->
        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- New XML Registration Activity -->
        <activity
            android:name=".ui.activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".ui.activities.HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".ui.activities.RecipeDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".ui.activities.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

<!-- Allow AppCompat to preserve app language choices on Android 12 and below. -->
<service
    android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
    android:enabled="false"
    android:exported="false">

    <meta-data
        android:name="autoStoreLocales"
        android:value="true" />

</service>

    </application>

</manifest>
